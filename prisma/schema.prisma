datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LocationSpoke {
  id          String       @id @default(cuid())
  slug        String       @unique // "federal-way", "auburn", "tacoma"
  cityName    String
  county      String       // "King County", "Pierce County"
  zipCodes    String[]     // ["98003", "98023"]
  coordinates Float[]      // [47.3073, -122.3107]
  wikidataUri String       // "https://www.wikidata.org/wiki/Q852586"
  jobs        JobStory[]
  socialPosts SocialPost[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
  @@index([county])
}

model JobStory {
  id              String        @id @default(cuid())
  externalJobId   String?       @unique // e.g. "amz-98421"
  slug            String?       @unique // e.g. "commercial-appliance-removal-auburn-98421"
  locationId      String
  location        LocationSpoke @relation(fields: [locationId], references: [id], onDelete: Cascade)
  serviceType     String        // "Commercial Appliance", "Estate Cleanout"
  itemCategory    String        // "True 2-Door Reach-in Cooler"
  weightLbs       Int?
  equipmentUsed   String?       // "16-ft Box Truck, Hydraulic Liftgate"
  disposalSite    String?       // "Bow Lake Transfer Station"
  disposalReceipt String?       // e.g. "WA-ALG-2026-8819"
  customerReview  String?
  reviewRating    Int?          @default(5)
  reviewSource    String?       // "google", "amzy", "facebook"
  reviewerName    String?
  reviewPlatform  String?       @default("Google")
  reviewUrl       String?
  ownerReply      String?
  ownerReplyDate  DateTime?
  mediaUrls       String[]      @default([])
  completedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([locationId])
  @@index([serviceType])
  @@index([completedAt(sort: Desc)])
  @@index([slug])
  @@index([externalJobId])
}

model SocialPost {
  id          String         @id @default(cuid())
  locationId  String?
  location    LocationSpoke? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  platform    String         // "youtube", "facebook", "instagram"
  externalId  String         @unique
  caption     String
  mediaUrl    String
  videoUrl    String?
  publishedAt DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([locationId])
  @@index([platform])
}
